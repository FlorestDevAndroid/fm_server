<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1a1a2e"
            android:padding="16dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FM Server"
                android:textSize="36sp"
                android:textColor="#e94560"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Локальный чат без интернета"
                android:textSize="16sp"
                android:textColor="#888888"
                android:layout_marginBottom="32dp" />

        <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сервер не запущен"
                android:textSize="16sp"
                android:textColor="#eeeeee"
                android:gravity="center"
                android:padding="16dp"
                android:background="#16213e"
                android:layout_marginBottom="16dp" />

        <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="#4ecdc4"
                android:gravity="center"
                android:padding="16dp"
                android:background="#1b2a47"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

        <Button
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Запустить сервер"
                android:textSize="18sp"
                android:backgroundTint="#e94560"
                android:textColor="#ffffff"
                android:layout_marginBottom="16dp" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Как это работает:\n1. Нажми 'Запустить сервер'\n2. Получи SSID и пароль\n3. Передай друзьям\n4. Они подключаются к твоему WiFi\n5. Запускают Client FM"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"
                android:padding="16dp"
                android:background="#0f3460"
                android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>